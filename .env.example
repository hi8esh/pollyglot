# Option A: Universal OpenAI SDK env vars (works for OpenRouter, Groq, OpenAI, or any compatible baseURL)
AI_KEY=
AI_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-nano-9b-v2:free

# Option B: Provider-specific Vite env vars (optional)
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free

VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
